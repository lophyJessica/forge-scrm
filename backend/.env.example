# forge-scrm 后端环境变量样例
# 复制为 .env 后按实际值填写；.env 已被 .gitignore 排除，禁止提交

# ---- 应用 ----
APP_NAME=forge-scrm
APP_ENV=local
LOG_LEVEL=INFO

# ---- 数据库 ----
# 本地开发（SQLite 兼容模式）
DATABASE_URL=sqlite:///./data/forge_scrm.db
# VPS 部署（MySQL 标准）示例：
# DATABASE_URL=mysql+pymysql://forge:<password>@127.0.0.1:3306/forge_scrm?charset=utf8mb4

# ---- JWT ----
# 生产环境必须替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---- 种子管理员账号（首次启动自动创建，登录后请立即改密）----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# ---- DeepSeek ----
# 绝不硬编码，只能从环境变量注入
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRY=3

# ---- 本地文件存储（D-T4，一期本地磁盘）----
DATA_DIR=./data

# ---- CORS（前端本地开发）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
